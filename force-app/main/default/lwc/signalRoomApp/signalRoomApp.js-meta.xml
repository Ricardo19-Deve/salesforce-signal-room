    <isExposed>true</isExposed>
    <masterLabel>Signal Room</masterLabel>
    <description>AI-enabled lead prioritisation and activation: pointers, account 360, weekly signal room.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__Tab</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="fullScreen" type="Boolean" default="false" label="Full screen" description="Fill the whole browser window (hides the site header/footer)." />
            <property name="brandName" type="String" default="Contoso Medical" label="Company name" />
            <property name="appName" type="String" default="Signal Room" label="App name" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
